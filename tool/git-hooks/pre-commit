import 'dart:io';

Future<void> main() async {
  try {
    exitCode = await Process.start('dart', [
      'run',
      'tool${Platform.pathSeparator}run_pre_commit_checks.dart',
    ], mode: .inheritStdio).then((process) => process.exitCode);
  } catch (e) {
    stderr.writeln(e.toString());
    exitCode = 1;
  }
}
