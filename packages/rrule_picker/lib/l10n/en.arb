    "rrulePickerDays": "{count, plural, =1{day} other{days}}",
    "@rrulePickerDays": {
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    },

    "rrulePickerEveryDaily": "{count, plural, other{Every}}",
    "@rrulePickerEveryDaily": {
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    },

    "rrulePickerEveryWeekly": "{count, plural, other{Every}}",
    "@rrulePickerEveryWeekly": {
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    },

    "rrulePickerRecurrenceType": "{name, select, daily{Daily} weekly{Weekly} monthly{Monthly} yearly{Yearly} other{Never}}",
    "@rrulePickerRecurrenceType": {
        "placeholders": {
            "name": {
                "type": "String"
            }
        },
        "description": "Display values for recurrence type dropdown"
    },

    "rrulePickerTitle": "Repeat",
    "@rrulePickerTitle": {
        "description": "Optional title of the whole widget"
    },

    "rrulePickerWeeks": "{count, plural, =1{week} other{weeks}}",
